# ONE location: copy this to `.env` at the REPOSITORY ROOT (next to this file),
# never under workers/ or apps/. workers/core/paths.py loads exactly that file
# (core.paths.ENV_FILE) and never overrides a variable already set, so on
# Railway, where there is no .env, the service's variables are used unchanged.
# apps/web keeps its own .env.local (gitignored) from Phase 2.

# Supabase — Connection Pooler (Session mode, port 5432).
# Supabase Dashboard -> Project Settings -> Database -> Connection string ->
# choose "Session pooler". Use the pooler host, NOT the direct db.<ref> host:
# direct connections are IPv6-only and most home ISPs can't reach them.
#
# This is the ONLY line that changes between environments.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Read-only inspection (db/018). Same pooler host and port, user is the
# valemont_readonly role. Used ONLY by workers/scripts/db_inspect.py, which never reads
# DATABASE_URL. Local .env only; the Railway worker does not need it.
# DATABASE_URL_READONLY=postgresql://valemont_readonly.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Railway canary gate. Must be exactly "true" to register the fake agent.
# Unset / anything else → main.py exits and the worker refuses to start.
# Never set this on a service that should run live agents.
# CANARY=true

# Added as we go. Keep this file in sync so future-you knows what exists.
# ANTHROPIC_API_KEY=
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true
