# Supabase — Connection Pooler (Session mode, port 5432).
# Supabase Dashboard -> Project Settings -> Database -> Connection string ->
# choose "Session pooler". Use the pooler host, NOT the direct db.<ref> host:
# direct connections are IPv6-only and most home ISPs can't reach them.
#
# This is the ONLY line that changes between environments.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Added as we go. Keep this file in sync so future-you knows what exists.
# ANTHROPIC_API_KEY=
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true
