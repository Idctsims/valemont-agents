# apps/web environment. Copy to .env.local (gitignored) and fill in.
# In Vercel, set the same three under Project > Settings > Environment Variables.

# Supabase > Project Settings > API. Public by design: they ship to the
# browser, and RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. The auth.users id of the one account allowed in
# (Supabase > Authentication > Users > your user > User UID).
# No NEXT_PUBLIC_ prefix: it must never reach the browser bundle.
OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# Web Push (VAPID). Generate once with `pnpm gen:vapid` (apps/web), which
# writes these here and the worker's three into the root .env, printing no
# values. The public key is safe in the browser; the private key is
# server-only (Vercel: mark it Sensitive). Rotating the pair orphans every
# existing push subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:duckfanboy@gmail.com
# External watchdog (/api/watchdog, called by cron-job.org every 5 minutes).
# WATCHDOG_TOKEN: `pnpm gen:watchdog-token` writes it here without printing it.
#   Vercel: Production, Sensitive. Also the cron job's Authorization header.
# SUPABASE_SECRET_KEY: Supabase > Project Settings > API Keys > Secret keys.
#   Bypasses RLS. Read ONLY by src/app/api/watchdog/route.ts (pnpm lint
#   enforces it). Vercel: Production, Sensitive. Never NEXT_PUBLIC_.
WATCHDOG_TOKEN=
SUPABASE_SECRET_KEY=
# WATCHDOG_PING_URL: the healthchecks.io check's ping URL. The route pings it
#   after every run (and <url>/fail when it cannot read the heartbeat);
#   healthchecks alerts if pings stop. Vercel: Production, Sensitive.
WATCHDOG_PING_URL=